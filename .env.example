WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhook/whatsapp
WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-secret
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_HOSTNAME=whatsapp.example.com
META_APP_SECRET=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v26.0
LOG_WEBHOOK_PAYLOADS=false
MAX_BODY_BYTES=1048576

# OpenRouter and automated replies
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ASSET_DIR=/data/assets
OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL_PRODUCTION=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=OpenReception
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_TOKENS=500
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_REASONING_ENABLED=false
ASSISTANT_SYSTEM_PROMPT=You are the business WhatsApp receptionist. Reply concisely and warmly in the same language as the customer. Do not invent prices, availability, policies, or appointment times. If information is missing, say that a staff member will help.

# Go business assistant and control panel
DATA_FILE=/data/state.json
ENV_FILE=/config/.env
BUSINESS_TIMEZONE=Asia/Jerusalem
ADMIN_PHONE_NUMBER=
CONTROL_PANEL_AUTH_ENABLED=true
CONTROL_PANEL_PASSWORD=replace-with-a-long-random-password
CONTROL_PANEL_SECRET=replace-with-at-least-32-random-bytes
CONTROL_PANEL_COOKIE_SECURE=true
